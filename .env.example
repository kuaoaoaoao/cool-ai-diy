# 本地开发环境默认配置
# 复制此文件为 .env 并修改配置
# cp .env.example .env

# ============ Java ============
JAVA_HOME=/Users/kuao/Library/Java/JavaVirtualMachines/ms-17.0.17/Contents/Home

# ============ 数据库 ============
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=coolai
POSTGRES_USER=coolai
POSTGRES_PASSWORD=coolai123

# ============ Redis ============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============ RabbitMQ ============
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=coolai
RABBITMQ_PASSWORD=coolai123

# ============ MinIO ============
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=coolai
MINIO_SECRET_KEY=coolai12345
MINIO_BUCKET=coolai

# ============ Milvus ============
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ============ Nacos ============
NACOS_ADDR=localhost:8848

# ============ LLM API Keys ============
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=

# ============ MCP API Keys ============
TAVILY_API_KEY=
OPENWEATHERMAP_API_KEY=

# ============ JWT ============
JWT_SECRET=coolai-java-secret-key-must-be-at-least-256-bits-long-for-hs256
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# ============ GPU引擎开关 ============
COOLAI_VOICE_XTTS_ENABLED=false
COOLAI_SINGING_RVC_ENABLED=false
COOLAI_SINGING_DIFFSINGER_ENABLED=false
COOLAI_SINGING_SVC_ENABLED=false
COOLAI_VIDEO_COGVIDEO_ENABLED=false
COOLAI_VIDEO_SVD_ENABLED=false
COOLAI_DEEPFAKE_FACEFUSION_ENABLED=false
COOLAI_DEEPFAKE_INSWAPPER_ENABLED=false
COOLAI_DEEPFAKE_LIVEPORTRAIT_ENABLED=false
COOLAI_DEEPFAKE_ROOP_ENABLED=false
COOLAI_TTS_COSYVOICE_ENABLED=false
